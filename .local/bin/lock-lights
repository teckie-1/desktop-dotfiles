#!/usr/bin/env bash
# Turn off ambient lighting (WLED + HyperHDR LEDDEVICE) while locked, restore on unlock.
set -uo pipefail

WLED_HOST="192.168.30.103"
HYPERHDR_API="http://localhost:8090/json-rpc"

off() {
  curl -sS -m3 -X POST -d '{"command":"componentstate","componentstate":{"component":"LEDDEVICE","state":false}}' "$HYPERHDR_API" >/dev/null 2>&1
  curl -sS -m3 -X POST -d '{"on":false}' "http://$WLED_HOST/json/state" >/dev/null 2>&1
}

on() {
  curl -sS -m3 -X POST -d '{"on":true}' "http://$WLED_HOST/json/state" >/dev/null 2>&1
  curl -sS -m3 -X POST -d '{"command":"componentstate","componentstate":{"component":"LEDDEVICE","state":true}}' "$HYPERHDR_API" >/dev/null 2>&1
}

off
swaylock --config ~/.config/swaylock/config
on
