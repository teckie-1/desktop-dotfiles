#!/usr/bin/env bash
set -euo pipefail

# setwall - set wallpaper with swww, generate wal colors from the same image,
# then restart waybar and update GTK3 css links.
#
# Usage:
#   setwall /path/to/wallpaper.jpg
#   setwall --restore

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="${STATE_DIR}/wallpaper"
mkdir -p "$STATE_DIR"

die(){ echo "setwall: $*" >&2; exit 1; }

restore() {
  [[ -f "$STATE_FILE" ]] || exit 0
  local saved
  saved="$(cat "$STATE_FILE")"
  [[ -f "$saved" ]] || exit 0
  exec "$0" "$saved"
}

if [[ "${1:-}" == "--restore" ]]; then
  restore
fi

WALL="${1:-}"
[[ -n "$WALL" ]] || die "Wallpaper not provided"
[[ -f "$WALL" ]] || die "Wallpaper not found: $WALL"

# Save wallpaper path
echo "$WALL" > "$STATE_FILE"


# Pre-seed FZF_DEFAULT_OPTS so wal's generated colors.sh doesn't trip `set -u`
# when it references $FZF_DEFAULT_OPTS unset (pywal's stock template does this).
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-}"

# Ensure awww daemon exists
if ! pgrep -f "awww-daemon" >/dev/null 2>&1; then
  setsid -f awww-daemon --no-cache >/dev/null 2>&1
  sleep 0.3
fi

# Set wallpaper
awww img "$WALL"

# Generate wal scheme from THIS wallpaper (do NOT let wal set wallpaper)
# This is the same command you successfully ran earlier.
wal -i "$WALL" -n


# Update Firefox theme from pywal colors (Pywalfox) — safe & non-blocking
if pgrep -x firefox >/dev/null 2>&1 || pgrep -x firefox-bin >/dev/null 2>&1; then
  (pywalfox update >/dev/null 2>&1 &)
fi

# --- OpenRGB: sync case (motherboard) + mouse lighting to whichever wal color is most vivid ---
# Picks the most saturated swatch out of color1-6 instead of a fixed index, since the
# "most vibrant" index pywal ranks first doesn't reliably match the wallpaper's dominant look.
# The picked color is then re-saturated/clamped in lightness, since the case fans' white
# diffuser rings wash blended hues out toward pale/cream at the raw wal value.
if command -v openrgb >/dev/null 2>&1 && [[ -f "$HOME/.cache/wal/colors.json" ]]; then
  RGB_COLOR="$(python3 - <<'PYEOF' 2>/dev/null
import json, colorsys, os
d = json.load(open(os.path.expanduser("~/.cache/wal/colors.json")))
candidates = {k: v for k, v in d["colors"].items() if k in ("color1","color2","color3","color4","color5","color6")}
def sat(hexcode):
    h = hexcode.lstrip("#")
    r, g, b = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4))
    return colorsys.rgb_to_hls(r, g, b)[2]
best_hex = max(candidates.items(), key=lambda kv: sat(kv[1]))[1]
h = best_hex.lstrip("#")
r, g, b = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4))
hue, light, _ = colorsys.rgb_to_hls(r, g, b)
r2, g2, b2 = colorsys.hls_to_rgb(hue, min(max(light, 0.4), 0.5), 1.0)
print("".join(f"{int(c*255):02X}" for c in (r2, g2, b2)))
PYEOF
)"
  if [[ -n "$RGB_COLOR" ]]; then
    (openrgb --client localhost:6742 \
      --device "B650" --mode static --color "$RGB_COLOR" --brightness 65 \
      --device "Basilisk" --mode static --color "$RGB_COLOR" --brightness 65 \
      >/dev/null 2>&1 &)
  fi
fi


# --- Waybar: ensure the imported file exists and is GTK-compatible ---
# Your waybar/style.css imports: ~/.cache/wal/colors-waybar.css
# We fixed this by creating a wal template that outputs GTK CSS (@define-color).
# If for some reason it isn't present, fall back to colors.css so waybar won't crash.
if [[ ! -f "$HOME/.cache/wal/colors-waybar.css" && -f "$HOME/.cache/wal/colors.css" ]]; then
  ln -sf "$HOME/.cache/wal/colors.css" "$HOME/.cache/wal/colors-waybar.css"
fi

# --- GTK3: point GTK at wal-generated css ---
# GTK3 reads: ~/.config/gtk-3.0/gtk.css
mkdir -p "$HOME/.config/gtk-3.0"
if [[ -f "$HOME/.cache/wal/gtk-3.0.css" ]]; then
  ln -sf "$HOME/.cache/wal/gtk-3.0.css" "$HOME/.config/gtk-3.0/gtk.css"
fi

# Also satisfy legacy path some configs/scripts import:
mkdir -p "$HOME/.cache/wal/gtk-3.0"
if [[ -f "$HOME/.cache/wal/gtk-3.0.css" ]]; then
  ln -sf "$HOME/.cache/wal/gtk-3.0.css" "$HOME/.cache/wal/gtk-3.0/gtk.css"
fi

# --- Thunderbird: symlink wal-generated userChrome.css ---
# Picked up next time Thunderbird is launched (userChrome.css does not hot-reload).
THUNDERBIRD_PROFILE="$HOME/.thunderbird/yfscuumj.default-release"
mkdir -p "$THUNDERBIRD_PROFILE/chrome"
if [[ -f "$HOME/.cache/wal/thunderbird-userChrome.css" ]]; then
  ln -sf "$HOME/.cache/wal/thunderbird-userChrome.css" "$THUNDERBIRD_PROFILE/chrome/userChrome.css"
fi

# Update MangoHud colors (pywal sync)
if [[ -x "$HOME/.local/bin/mangohud-pywal" ]]; then
  "$HOME/.local/bin/mangohud-pywal"
fi

# Reload Vesktop Quick CSS (Vencord watches the file via inotify)
if pgrep -x vesktop > /dev/null 2>&1; then
  touch "$HOME/.cache/wal/vesktop.css"
fi

# Reload qutebrowser config via IPC socket (avoids Python module cache issue)
python3 - <<'PYEOF' 2>/dev/null || true
import socket, json, glob, os
for path in glob.glob(f'/run/user/{os.getuid()}/qutebrowser/ipc-*'):
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(2)
        s.connect(path)
        s.sendall(json.dumps({'args': [':config-source'], 'target_arg': None, 'protocol_version': 1}).encode() + b'\n')
        s.close()
    except Exception:
        pass
PYEOF

# Reload waybar so new colors apply
pkill -x waybar >/dev/null 2>&1 || true
waybar >/dev/null 2>&1 &

exit 0


